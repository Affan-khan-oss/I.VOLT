# Server-side key for the /api/chat backend (Groq). Never commit a real value.
# Put your key in .env.local for local development (see README / Vercel dashboard for production).
GROQ_API_KEY=

# Web3Forms access key for the Contact page "Send Us a Message" form (no backend).
# Get yours at https://web3forms.com and set it in .env.local as VITE_WEB3FORMS_KEY.
VITE_WEB3FORMS_KEY=a4e974b0-7866-47b7-a82a-773c3fb432ee
